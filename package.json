{
  "name": "desktop-buddies",
  "productName": "Desktop Buddies",
  "version": "2.1.1",
  "description": "Desktop companions — a little white cat, Iron Man, Homelander, Hulk and Spider-Man — that live on your screen.",
  "main": "src/main/main.js",
  "author": "Desktop Buddies",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "start:cat": "electron . --edition=cat",
    "start:ironman": "electron . --edition=ironman",
    "start:homelander": "electron . --edition=homelander",
    "start:hulk": "electron . --edition=hulk",
    "start:spiderman": "electron . --edition=spiderman",
    "test": "node dev/sim-test.js && node dev/geo-test.js && node dev/iron-test.js && node dev/homelander-test.js && node dev/hulk-test.js && node dev/spiderman-test.js && node dev/desktopcat-test.js",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "android": "node scripts/build-android.js",
    "mobile": "node scripts/build-mobile.js",
    "editions": "node scripts/build-editions.js",
    "editions:win": "node scripts/build-editions.js --win",
    "editions:mac": "node scripts/build-editions.js --mac",
    "editions:linux": "node scripts/build-editions.js --linux"
  },
  "build": {
    "appId": "app.desktopbuddies",
    "productName": "Desktop Buddies",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/*.png",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Desktop Buddies listens for right-clicks to open its menu."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "maintainer": "Desktop Buddies",
      "executableArgs": [
        "--ozone-platform=x11"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
